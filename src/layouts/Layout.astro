---
import Header from "../components/Header.astro"
import "../styles/global.css"

interface Props {
  title?: string;
}

const { title = "Tailspin Toys" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <script is:inline>
            try {
                if (localStorage.getItem('tailspin-high-contrast') === 'true') {
                    document.documentElement.classList.add('high-contrast');
                }
            } catch {
                // Storage can be unavailable in privacy-restricted browsers.
            }
        </script>
        <!-- Preconnect to improve font loading -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </head>
    <body class="min-h-screen bg-slate-900 text-white transition-colors duration-300 motion-reduce:transition-none m-0 w-full h-full font-sans">
        <Header />
        <main class="container mx-auto py-6 h-full max-w-7xl">
            <div class="px-4 sm:px-6 lg:px-8">
                <slot />
            </div>
        </main>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }
    
    html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
    }
    
    body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    /* The toggle deliberately uses a stronger palette than the normal dark theme. */
    html.high-contrast body {
        background-color: #000;
        color: #fff;
    }

    html.high-contrast header {
        background-color: #000;
        border-bottom: 2px solid #fff;
    }

    html.high-contrast [class~="bg-slate-800/60"],
    html.high-contrast [class~="bg-slate-800/70"],
    html.high-contrast [class~="bg-slate-800/50"] {
        background-color: #000;
    }

    html.high-contrast [class~="border-slate-700"],
    html.high-contrast [class~="border-slate-700/50"],
    html.high-contrast [class~="border-slate-600"] {
        border-color: #fff;
    }

    html.high-contrast .text-slate-400,
    html.high-contrast .text-slate-300,
    html.high-contrast .text-slate-200,
    html.high-contrast .text-slate-100,
    html.high-contrast .text-white {
        color: #fff;
    }

    html.high-contrast a {
        color: #fff;
        text-decoration: underline;
        text-decoration-thickness: 2px;
    }

    html.high-contrast a:hover,
    html.high-contrast button:hover {
        background-color: #222;
        color: #ffeb3b;
    }

    html.high-contrast button:focus-visible,
    html.high-contrast a:focus-visible {
        outline: 3px solid #ffeb3b;
        outline-offset: 3px;
    }
</style>
