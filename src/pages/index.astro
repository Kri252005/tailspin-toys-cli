---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const database = getDatabase();
const games = await getAllGames(database);
const publishers = await getAllPublishers(database);
const categories = Array.from(
  new Map(
    games
      .flatMap((game) => (game.category ? [[game.category.id, game.category]] : [])),
  ).values(),
).sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        <form
          class="grid gap-4 rounded-xl border border-slate-700 bg-slate-800/50 p-4 sm:grid-cols-2"
          data-testid="game-filters"
          aria-label="Filter games"
        >
          <label class="flex flex-col gap-2 text-sm text-slate-200">
            <span>Categories</span>
            <select
              name="category"
              multiple
              class="min-h-24 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="category-filter"
              aria-describedby="filter-help"
            >
              {categories.map((category) => (
                <option value={category.id}>{category.name}</option>
              ))}
            </select>
          </label>

          <label class="flex flex-col gap-2 text-sm text-slate-200">
            <span>Publishers</span>
            <select
              name="publisher"
              multiple
              class="min-h-24 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="publisher-filter"
              aria-describedby="filter-help"
            >
              {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </label>

          <div class="flex items-center justify-between gap-3 sm:col-span-2">
            <p id="filter-help" class="text-xs text-slate-400">Hold Ctrl or Command to select multiple options.</p>
            <button
              type="button"
              class="rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-50"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
          </div>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div
          class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          data-testid="games-grid"
          aria-live="polite"
        >
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      {games.length > 0 && (
        <div class="hidden" data-testid="filtered-empty-state">
          <EmptyState text="No games match the selected filters." />
        </div>
      )}
      <p class="sr-only" data-testid="filter-status" aria-live="polite"></p>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const categoryFilter = filterForm?.querySelector<HTMLSelectElement>('[name="category"]');
  const publisherFilter = filterForm?.querySelector<HTMLSelectElement>('[name="publisher"]');
  const clearFilters = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const filteredEmptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const filterStatus = document.querySelector<HTMLElement>('[data-testid="filter-status"]');

  if (filterForm && categoryFilter && publisherFilter && clearFilters && gamesGrid && filteredEmptyState && filterStatus) {
    const gameCards = Array.from(gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const filters = [categoryFilter, publisherFilter];

    const selectedValues = (select: HTMLSelectElement): string[] =>
      Array.from(select.selectedOptions, (option) => option.value);

    const updateUrl = (): void => {
      const url = new URL(window.location.href);
      url.searchParams.delete('category');
      url.searchParams.delete('publisher');

      for (const value of selectedValues(categoryFilter)) {
        url.searchParams.append('category', value);
      }
      for (const value of selectedValues(publisherFilter)) {
        url.searchParams.append('publisher', value);
      }

      window.history.replaceState({}, '', url);
    };

    const applyFilters = (): void => {
      const selectedCategories = new Set(selectedValues(categoryFilter));
      const selectedPublishers = new Set(selectedValues(publisherFilter));
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryMatches =
          selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublishers.size === 0 || selectedPublishers.has(card.dataset.publisherId ?? '');
        const isVisible = categoryMatches && publisherMatches;

        card.hidden = !isVisible;
        card.setAttribute('aria-hidden', String(!isVisible));
        if (isVisible) visibleCount += 1;
      }

      const hasFilters = selectedCategories.size > 0 || selectedPublishers.size > 0;
      gamesGrid.hidden = visibleCount === 0;
      filteredEmptyState.classList.toggle('hidden', visibleCount !== 0);
      clearFilters.disabled = !hasFilters;
      filterStatus.textContent = `Showing ${visibleCount} of ${gameCards.length} games.`;
    };

    const syncFromUrl = (): void => {
      const params = new URLSearchParams(window.location.search);
      const selectedCategories = new Set(params.getAll('category'));
      const selectedPublishers = new Set(params.getAll('publisher'));

      for (const option of categoryFilter.options) {
        option.selected = selectedCategories.has(option.value);
      }
      for (const option of publisherFilter.options) {
        option.selected = selectedPublishers.has(option.value);
      }

      applyFilters();
    };

    for (const filter of filters) {
      filter.addEventListener('change', () => {
        updateUrl();
        applyFilters();
      });
    }

    clearFilters.addEventListener('click', () => {
      for (const filter of filters) {
        filter.selectedIndex = -1;
      }
      updateUrl();
      applyFilters();
    });

    window.addEventListener('popstate', syncFromUrl);
    syncFromUrl();
  }
</script>
